
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /macros/{macroId} {
      // Каталог доступен для чтения всем.
      allow read: if true;

      // Изменять карточки может только заданный UID.
      allow create, update, delete:
        if request.auth != null
        && request.auth.uid == "REPLACE_WITH_ADMIN_UID";
    }

    // Все остальные документы закрыты.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
